  m_Script: {fileID: 11500000, guid: 9ea3e97f44d6991358e3741abaa9733c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  stageNumber: 4
  stageTitle: "STAGE 4 \u2014 EVENT HORIZON"
  objective: 3
  objectiveText: ESCAPE COMPLETE
  introText: 'The engine is online, but the way home runs through a dead star''s
    shadow.

    Its gravity is bending the debris field, and the bridges are drifting
    out of reach.



    Stay together. Carry each other through the eclipse and
    reach the ship before the light goes out.'
  completeTitle: ENGINE ONLINE
  completeText: 'The shadow lifts. The stars return, and the ship turns for home.



    Thanks
    for playing BORROWED GRAVITY!'
  isFinalStage: 1
  holdToResetSeconds: 1
  playAmbience: 1
  autoContinueAfter: 4
  autoStartAfter: 8
